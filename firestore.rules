rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// Or paste into Firebase Console → Firestore → Rules
//
// Admin emails must match adminEmails in firebase-config.js.
// The Admin list reads userDirectory only (identity + usage counts).
// Admins may get a single users/{userId} doc to temporarily view
// that budget. They cannot write someone else's budget.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'alex.mangin35@gmail.com'
        ];
    }

    match /users/{userId} {
      allow get, write: if isOwner(userId);
      allow get: if isAdmin();
    }

    match /userDirectory/{userId} {
      allow read, write: if isOwner(userId);
      allow read: if isAdmin();
    }

  }
}
