rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// Or paste into Firebase Console → Firestore → Rules
//
// Admin emails must match adminEmails in firebase-config.js.
// The Admin page shows identity only. Admins may list users/{userId}
// to include offline accounts, but the UI never displays budget data.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'alex.mangin35@gmail.com'
        ];
    }

    match /users/{userId} {
      // Owners read/write their budget. Admins may list accounts
      // so the Admin page can show people who are offline too.
      allow read, write: if isOwner(userId);
      allow read: if isAdmin();
    }

    match /userDirectory/{userId} {
      // Identity only (name, email, provider, last seen).
      // Owners write their own row; admins can list and backfill.
      allow read, write: if isOwner(userId);
      allow read, write: if isAdmin();
    }

  }
}
